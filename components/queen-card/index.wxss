:host {
    display: block;
    width: 100%;
    height: 100%;
}

.queen-card {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    background: #FFD740;
    border: 5rpx solid #000;
    border-radius: 24rpx;
    box-shadow: 8rpx 10rpx 0 #000;
    color: #000;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    font-weight: 900;
}

.queen-card::before {
    content: '';
    position: absolute;
    width: 132%;
    height: 36%;
    left: -16%;
    top: 29%;
    background: #FF4081;
    transform: rotate(-9deg);
    border-top: 4rpx solid #000;
    border-bottom: 4rpx solid #000;
}

.queen-card::after {
    content: '';
    position: absolute;
    inset: 4%;
    z-index: 1;
    box-sizing: border-box;
    border: 2rpx solid rgba(0, 0, 0, 0.14);
    border-radius: 18rpx;
    pointer-events: none;
}

.queen-corner {
    position: absolute;
    left: 9%;
    top: 6%;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.queen-corner.bottom {
    left: auto;
    top: auto;
    right: 6%;
    bottom: 3%;
    transform: rotate(180deg);
}

.queen-corner.bottom .queen-rank { font-size: 0.14em; }
.queen-corner.bottom .corner-beam { width: 0.11em; }

.queen-rank {
    font-size: 0.18em;
    line-height: 1;
}

.corner-beam {
    width: 0.14em;
    height: 0.045em;
    margin-top: 0.025em;
    border: 0.018em solid currentColor;
    border-radius: 999rpx;
    transform: skewX(-18deg);
}

.laser-mark {
    position: absolute;
    left: 50%;
    top: 42%;
    z-index: 4;
    width: 62%;
    height: 27%;
    transform: translate(-50%, -50%) rotate(-5deg);
}

.laser-body {
    position: absolute;
    right: 11%;
    top: 23%;
    width: 55%;
    height: 42%;
    box-sizing: border-box;
    background: #FFFDE7;
    border: 0.025em solid #000;
    border-radius: 40% 17% 25% 40%;
}

.laser-core {
    position: absolute;
    right: 14%;
    top: 25%;
    width: 0.15em;
    height: 0.15em;
    box-sizing: border-box;
    background: #FFD740;
    border: 0.02em solid #000;
    border-radius: 50%;
}

.laser-barrel {
    position: absolute;
    left: 4%;
    top: 34%;
    width: 39%;
    height: 22%;
    box-sizing: border-box;
    background: #FFFDE7;
    border: 0.025em solid #000;
    border-radius: 999rpx 0 0 999rpx;
}

.laser-handle {
    position: absolute;
    right: 24%;
    top: 57%;
    width: 20%;
    height: 38%;
    box-sizing: border-box;
    background: #FFFDE7;
    border: 0.025em solid #000;
    border-radius: 0 0 0.08em 0.08em;
    transform: skewX(-12deg);
}

.laser-trigger {
    position: absolute;
    right: 42%;
    top: 60%;
    width: 13%;
    height: 16%;
    box-sizing: border-box;
    border: 0.02em solid #000;
    border-radius: 50%;
}

.laser-ray {
    position: absolute;
    left: -5%;
    width: 23%;
    height: 0.022em;
    background: #000;
    transform-origin: right center;
}

.ray-one { top: 20%; transform: rotate(18deg); }
.ray-two { top: 44%; }
.ray-three { top: 68%; transform: rotate(-18deg); }

.queen-copy {
    position: absolute;
    left: 50%;
    top: 58%;
    z-index: 5;
    width: 86%;
    min-height: 20%;
    padding: 0.025em 0.03em;
    box-sizing: border-box;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #FFF;
    border: 0.018em solid #000;
    border-radius: 0.075em;
    color: #000;
    text-align: center;
}

.queen-eyebrow {
    color: #FF1744;
    font-size: 0.055em;
    line-height: 1;
    letter-spacing: 0.16em;
}

.queen-title {
    width: 100%;
    margin-top: 0.025em;
    font-size: 0.078em;
    line-height: 1;
    letter-spacing: 0.015em;
    white-space: nowrap;
    word-break: keep-all;
    overflow: hidden;
    text-overflow: clip;
}

.size-drawn { font-size: 230rpx; }
.size-mini {
    border-width: 2rpx;
    border-radius: 8rpx;
    box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.14);
    font-size: 44rpx;
}
.size-mini .queen-copy { display: none; }
