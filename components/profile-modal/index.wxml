<!-- 头像昵称填写弹窗 -->
<view class="modal-mask" wx:if="{{visible}}" catchtap="onClose">
    <view class="modal-container" catchtap="preventBubble">
        <!-- 标题 -->
        <view class="modal-header">
            <text class="modal-title">{{title}}</text>
            <text class="modal-desc">{{description}}</text>
        </view>

        <!-- 表单内容 -->
        <form bindsubmit="onFormSubmit">
            <view class="modal-body">
                <!-- 头像选择 -->
                <view class="avatar-section">
                    <button 
                        class="avatar-button" 
                        plain="{{true}}"
                        hover-class="none"
                        open-type="chooseAvatar" 
                        bind:chooseavatar="onChooseAvatar"
                    >
                        <image class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
                    </button>
                    <text class="avatar-hint">{{uiCopy.avatarHint}}</text>
                </view>

                <!-- 昵称输入 -->
                <view class="nickname-section">
                    <view class="input-wrapper">
                        <input 
                            class="nickname-input" 
                            type="nickname" 
                            name="nickname"
                            placeholder="{{uiCopy.nicknamePlaceholder}}" 
                            value="{{nickname}}"
                            bindinput="onNicknameInput"
                            bindblur="onNicknameBlur"
                            maxlength="20"
                        />
                    </view>
                </view>
            </view>

            <!-- 底部按钮 -->
            <view class="modal-footer">
                <button 
                    class="confirm-btn" 
                    form-type="submit"
                    disabled="{{isSubmitting}}"
                >
                    <text class="btn-text" wx:if="{{!isSubmitting}}">{{confirmText}}</text>
                    <text class="btn-text" wx:if="{{isSubmitting}}">{{uiCopy.submitting}}</text>
                </button>
                <!-- 底部提示文案 -->
                <view class="footer-hint" wx:if="{{footerHint}}">
                    <text class="footer-hint-text">{{footerHint}}</text>
                </view>
            </view>
        </form>
    </view>
</view>
