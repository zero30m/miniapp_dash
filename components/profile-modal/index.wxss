/* 头像昵称填写弹窗样式 */

.modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 25vh;
    z-index: 1000;
}

.modal-container {
    width: 580rpx;
    background: #FFFDE7;
    border-radius: 32rpx;
    border: 4rpx solid #000000;
    box-shadow: 8rpx 8rpx 0 0 #000000;
    overflow: visible;
}

/* 头部 */
.modal-header {
    padding: 40rpx 36rpx 20rpx;
    text-align: center;
}

.modal-title {
    display: block;
    font-size: 36rpx;
    font-weight: 900;
    color: #000000;
    margin-bottom: 8rpx;
}

.modal-desc {
    display: block;
    font-size: 24rpx;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.5);
}

/* 内容区域 */
.modal-body {
    padding: 24rpx 36rpx;
}

/* 头像选择 */
.avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 32rpx;
    background: #FFFDE7;
}

.avatar-button {
    position: relative;
    width: 140rpx;
    height: 140rpx;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    border-radius: 50% !important;
    overflow: visible !important;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none !important;
    outline: none !important;
    -webkit-tap-highlight-color: transparent;
}

/* 彻底移除 button 的所有伪元素和默认样式 */
.avatar-button::before,
.avatar-button::after {
    content: none !important;
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

/* 移除 button 的 hover 和 active 状态背景 */
.avatar-button[hover-class],
.avatar-button:hover,
.avatar-button:active,
.avatar-button:focus {
    background: transparent !important;
    background-color: transparent !important;
}

.avatar-image {
    width: 136rpx;
    height: 136rpx;
    border-radius: 50%;
    border: 3rpx solid #000000;
    background: #EEEEEE;
}

.avatar-hint {
    margin-top: 12rpx;
    font-size: 22rpx;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.4);
}

/* 昵称输入 */
.nickname-section {
    width: 100%;
}

.input-wrapper {
    background: #FFFFFF;
    border: 3rpx solid #000000;
    border-radius: 16rpx;
    box-shadow: 3rpx 3rpx 0 0 #000000;
    padding: 20rpx 28rpx;
}

.nickname-input {
    width: 100%;
    font-size: 30rpx;
    font-weight: 700;
    color: #000000;
}

.nickname-input::placeholder {
    color: rgba(0, 0, 0, 0.3);
    font-weight: 600;
}

/* 底部按钮 */
.modal-footer {
    padding: 20rpx 36rpx 36rpx;
}

.confirm-btn {
    width: 100%;
    height: 88rpx;
    background: #9B5DE5 !important;
    color: #FFFFFF;
    font-size: 30rpx;
    font-weight: 900;
    border-radius: 999rpx;
    border: 3rpx solid #000000;
    box-shadow: 5rpx 5rpx 0 0 #000000;
    transition: all 0.1s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.confirm-btn[disabled] {
    background: #9B5DE5 !important;
    opacity: 0.7;
    color: #FFFFFF !important;
}

.confirm-btn .btn-text {
    font-size: 30rpx;
    font-weight: 900;
    color: #FFFFFF;
}

.confirm-btn:active {
    transform: translate(2rpx, 2rpx);
    box-shadow: 3rpx 3rpx 0 0 #000000;
}

.confirm-btn::after {
    border: none;
}

/* 底部提示文案 */
.footer-hint {
    margin-top: 16rpx;
    text-align: center;
}

.footer-hint-text {
    font-size: 20rpx;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.4);
}
