}

.theme-couple_dare .card-type {
  background: #E91E63;
  color: #FFF;
}

/* ==================== 情侣暖甜交流 主题样式 ==================== */

.theme-couple_talk .card-body {
  background: #FFF;
  border-color: #000;
}

.theme-couple_talk .card-type {
  background: #FFAB91;
  color: #000;
}

/* ==================== COFFEE CHAT 主题样式 ==================== */

.theme-coffee .card-body {
  background: #FFF;
  border-color: #000;
}

.theme-coffee .card-type {
  background: #8D6E63;
  color: #FFF;
}

/* ==================== DIY 来源标签 ==================== */
.card-type.diy-source {
    /* 颜色由内联样式控制 - FIX-8 */
    font-size: 18rpx;
    letter-spacing: 4rpx;
}

/* ==================== DIY 卡牌飞入动画（从右上角依次飞入） ==================== */
@keyframes diyFlyIn {
    0% {
        transform: translate(400rpx, -600rpx) rotate(25deg) scale(0.3);
        opacity: 0;
    }
    60% {
        opacity: 1;
    }
    100% {
        /* 不指定终态，自动回到元素自身的 transform */
    }
}

/* 飞入时 active 卡牌 — 第一张飞入 */
.card-stack.diy-fly-in .card-container.active {
    animation: diyFlyIn 0.5s cubic-bezier(0.22, 0.8, 0.36, 1) backwards;
}

/* 飞入时 next1 — 第二张飞入，延迟 0.12s */
.card-stack.diy-fly-in .card-container.next1 {
    animation: diyFlyIn 0.5s cubic-bezier(0.22, 0.8, 0.36, 1) 0.12s backwards;
}

/* 飞入时 next2 — 第三张飞入，延迟 0.24s */
.card-stack.diy-fly-in .card-container.next2 {
    animation: diyFlyIn 0.5s cubic-bezier(0.22, 0.8, 0.36, 1) 0.24s backwards;
}
