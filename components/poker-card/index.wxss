:host {
    display: block;
    width: 100%;
    height: 100%;
}

.poker-card {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
    background: #FFF;
    border: 4rpx solid #000;
    border-radius: 24rpx;
    box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.16), 0 10rpx 22rpx rgba(0, 0, 0, 0.1);
    color: #111;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    font-weight: 900;
}

.poker-card.red {
    color: #E9273F;
}

.joker-mark-only {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111;
}

.joker-mark-only.red {
    color: #E9273F;
}

.poker-card.hide-corners .card-corner,
.poker-card.hide-corners .joker-corner {
    display: none;
}

.card-corner,
.joker-corner {
    position: absolute;
    left: 10%;
    top: 7%;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.9;
    z-index: 2;
}

.card-corner.bottom,
.joker-corner.bottom {
    left: auto;
    top: auto;
    right: 10%;
    bottom: 7%;
    transform: rotate(180deg);
}

.corner-rank {
    font-size: 0.21em;
    letter-spacing: -0.04em;
}

.corner-suit {
    margin-top: 0.12em;
    font-size: 0.18em;
}

.center-suit {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.62em;
    line-height: 1;
}

.joker-clown-mark {
    position: relative;
    width: 0.32em;
    height: 0.34em;
    color: currentColor;
}

.clown-hat-tip {
    position: absolute;
    top: 0.015em;
    width: 0;
    height: 0;
    border-left: 0.045em solid transparent;
    border-right: 0.045em solid transparent;
    border-bottom: 0.105em solid currentColor;
    transform-origin: center bottom;
}

.clown-hat-tip.tip-left {
    left: 0.025em;
    transform: rotate(-28deg);
}

.clown-hat-tip.tip-center {
    left: 0.115em;
}

.clown-hat-tip.tip-right {
    right: 0.025em;
    transform: rotate(28deg);
}

.clown-hat-dot {
    position: absolute;
    width: 0.035em;
    height: 0.035em;
    background: currentColor;
    border-radius: 50%;
}

.clown-hat-dot.dot-left {
    left: 0.012em;
    top: 0.012em;
}

.clown-hat-dot.dot-center {
    left: 0.142em;
    top: 0;
}

.clown-hat-dot.dot-right {
    right: 0.012em;
    top: 0.012em;
}

.clown-face {
    position: absolute;
    left: 0.045em;
    top: 0.105em;
    width: 0.23em;
    height: 0.205em;
    box-sizing: border-box;
    border: 0.018em solid currentColor;
    border-radius: 48% 48% 52% 52%;
    background: #FFF;
}

.clown-eye,
.clown-nose {
    position: absolute;
    background: currentColor;
    border-radius: 50%;
}

.clown-eye {
    top: 0.055em;
    width: 0.026em;
    height: 0.026em;
}

.clown-eye.eye-left {
    left: 0.045em;
}

.clown-eye.eye-right {
    right: 0.045em;
}

.clown-nose {
    left: 50%;
    top: 0.083em;
    width: 0.035em;
    height: 0.035em;
    transform: translateX(-50%);
}

.clown-smile {
    position: absolute;
    left: 50%;
    bottom: 0.022em;
    width: 0.095em;
    height: 0.045em;
    border-bottom: 0.018em solid currentColor;
    border-radius: 50%;
    transform: translateX(-50%);
}

.joker-center {
    position: absolute;
    inset: 18% 22%;
    border: 3rpx solid currentColor;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: rotate(-8deg);
}

.joker-word {
    font-size: 0.16em;
    letter-spacing: 0.12em;
}

.joker-center-star {
    font-size: 0.42em;
    line-height: 0.9;
}

.joker-kind {
    font-size: 0.09em;
    letter-spacing: 0.14em;
}

.size-petal {
    font-size: 128rpx;
}

.size-peek {
    font-size: 110rpx;
}

.size-mini {
    border-width: 2rpx;
    border-radius: 8rpx;
    box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.14);
    font-size: 44rpx;
}

.size-drawn {
    font-size: 230rpx;
    border-width: 5rpx;
    border-radius: 24rpx;
    box-shadow: 8rpx 10rpx 0 #000;
}
