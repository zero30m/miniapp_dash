<view class="finger-page" 
      catchtouchstart="onTouchStart" 
      catchtouchmove="onTouchMove" 
      catchtouchend="onTouchEnd" 
      catchtouchcancel="onTouchCancel">
  
  <!-- 背景光效 -->
  <view class="bg-glow top-left"></view>
  <view class="bg-glow bottom-right"></view>

  <!-- 返回按钮 -->
  <view class="back-btn" style="top: {{navTop}}px;" 
        catchtouchstart="onPreventBubble"
        catchtouchend="goBack">
    <text class="back-icon">‹</text>
    <text class="back-text">{{uiCopy.back}}</text>
  </view>

  <!-- 提示语 -->
  <view class="hint-container {{gameState === 'IDLE' ? 'show' : ''}}">
    <view class="hint-badge">{{uiCopy.maxPlayers}}</view>
    <view class="hint-title">{{uiCopy.navTitle}}</view>
    <view class="hint-divider"></view>
    <view class="hint-desc">{{uiCopy.hintDesc}}</view>
    <view class="hint-subdesc">{{uiCopy.hintSubdesc}}</view>
  </view>

  <!-- 手指光晕 -->
  <block wx:for="{{fingers}}" wx:key="id">
    <view class="finger-ring {{item.isWinner ? 'winner' : ''}} {{item.isEliminated ? 'eliminated' : ''}}" 
          style="left: {{item.x}}px; top: {{item.y}}px; --color: {{item.color}};">
      <view class="ring-core"></view>
      <view class="ring-glow"></view>
      <view class="ring-ripple"></view>
    </view>
  </block>

  <!-- 选择器动画 -->
  <view class="selector-ring" 
        wx:if="{{gameState === 'SELECTING'}}"
        style="left: {{selectorPos.x}}px; top: {{selectorPos.y}}px;">
  </view>

  <!-- 底部开始区域 (2-4人时显示) -->
  <view class="start-zone {{showStartZone ? 'show' : ''}}" 
        style="height: {{startZoneHeight}}px;"
        catchtouchstart="onStartZoneTap">
    <view class="start-zone-bg"></view>
    <view class="start-zone-content">
      <view class="start-zone-icon">👆</view>
      <view class="start-zone-text">{{uiCopy.startZone}}</view>
    </view>
    <view class="start-zone-glow"></view>
  </view>

  <!-- 结果弹窗 -->
  <view class="result-overlay {{gameState === 'RESULT' ? 'visible' : ''}}" 
        style="--winner-color: {{winnerColor}};" 
        catchtap="onResultTap">
    <view class="result-container {{gameState === 'RESULT' ? 'animating' : ''}}">
      <!-- 获胜者指示器 -->
      <view class="winner-indicator">
        <view class="winner-ring"></view>
        <view class="winner-glow"></view>
      </view>
      
      <!-- 文案 -->
      <view class="result-text-wrap">
        <text class="result-emoji">🫵</text>
        <text class="result-title">{{uiCopy.resultTitle}}</text>
      </view>
      
      <!-- 提示 -->
      <view class="result-hint">{{uiCopy.resultHint}}</view>
    </view>
    
    <!-- 装饰粒子 -->
    <view class="particle p1"></view>
    <view class="particle p2"></view>
    <view class="particle p3"></view>
    <view class="particle p4"></view>
    <view class="particle p5"></view>
    <view class="particle p6"></view>
  </view>

</view>
