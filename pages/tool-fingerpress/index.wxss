/* 按手指页面 - Neo-Brutalism (Mint Green) */
.finger-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: #FFFDE7; /* Cream */
  overflow: hidden;
  touch-action: none;
  --accent-mint: #00D084;
}

/* 移除光效 */
.bg-glow { display: none; }

/* 返回按钮 */
.back-btn {
  position: fixed;
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border: 4px solid #000000;
  border-radius: 999rpx;
  z-index: 50;
  box-shadow: 4px 4px 0 0 #000000;
}

.back-btn:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 0 #000;
}

.back-icon {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  line-height: 1;
}

.back-text {
  font-size: 26rpx;
  color: #000000;
  font-weight: 800;
}

/* 提示语 */
.hint-container {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  opacity: 0;
  pointer-events: none;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.hint-container.show { opacity: 1; }

.hint-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 30rpx;
  background: #000; /* Black Badge */
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: var(--accent-mint);
  letter-spacing: 2rpx;
  text-shadow: none;
}

.hint-title {
  font-size: 72rpx;
  font-weight: 900;
  color: #000;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
  text-shadow: none;
}

.hint-divider {
  width: 120rpx;
  height: 6rpx;
  background: #000;
  border-radius: 999rpx;
  margin: 8rpx 0;
  box-shadow: none;
}

.hint-desc {
  font-size: 32rpx;
  color: #000;
  font-weight: 700;
  opacity: 0.8;
}

.hint-subdesc {
  font-size: 26rpx;
  color: #000;
  opacity: 0.5;
}


/* 手指圆环 - 实心风格 */
.finger-ring {
  position: absolute;
  width: 360rpx; /* Increased from 300 */
  height: 360rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 10;
}

.ring-core {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 240rpx; /* Increased from 180 */
  height: 240rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 6rpx solid #000;
  background: var(--color); /* Player Color */
  box-shadow: 4px 4px 0 0 #000;
  animation: ringPulse 1.5s infinite ease-in-out;
}

/* 移除模糊光晕，改用实线波纹 */
.ring-glow { display: none; }

.ring-ripple {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 4rpx solid #000;
  opacity: 0;
  animation: ripple 2s infinite;
}

@keyframes ringPulse {
  0% { transform: translate(-50%, -50%) scale(0.95); }
  50% { transform: translate(-50%, -50%) scale(1.05); }
  100% { transform: translate(-50%, -50%) scale(0.95); }
}

@keyframes ripple {
  0% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }
}

/* 获胜动画 */
.finger-ring.winner .ring-core {
  /* Removed background: #fff so it keeps color */
  border-width: 12rpx; /* Thicker border to highlight */
  border-color: #000;
  z-index: 20;
  animation: winnerPulse 0.3s infinite alternate;
}
@keyframes winnerPulse {
  0% { transform: translate(-50%, -50%) scale(1); box-shadow: 4px 4px 0 0 #000; }
  100% { transform: translate(-50%, -50%) scale(1.3); box-shadow: 8px 8px 0 0 #000; } /* Larger scaling */
}

/* 淘汰动画 */
.finger-ring.eliminated {
  animation: eliminateFade 0.4s ease-out forwards;
}
@keyframes eliminateFade {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(0); }
}


/* 选择器圆环 - Hunter's Sight Style */
.selector-ring {
  position: absolute;
  width: 300rpx; /* Keep size large */
  height: 300rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  z-index: 20;
  pointer-events: none;
  transition: left 0.1s ease-out, top 0.1s ease-out;
  
  /* High Visibility: Solid Thick Border */
  border: 10rpx solid #000;
  box-shadow: 0 0 0 4rpx rgba(255,255,255,0.5); /* Subtle glowing edge */
  
  /* Excitement: Radar Sweep Gradient */
  background: conic-gradient(
    from 0deg, 
    transparent 0%, 
    transparent 60%, 
    rgba(0,0,0, 0.3) 100%
  );
  
  /* Faster spin for tension */
  animation: selectorSpin 1s linear infinite;
}

/* Scope Ticks (Targeting reticle feel) */
.selector-ring::before {
  content: '';
  display: block;
  position: absolute;
  top: -20rpx; left: 50%;
  width: 8rpx; height: 340rpx; /* Vertical line crossing through */
  background: linear-gradient(to bottom, #000 0%, #000 15%, transparent 15%, transparent 85%, #000 85%, #000 100%);
  transform: translateX(-50%);
}

.selector-ring::after {
  content: '';
  display: block;
  position: absolute;
  top: 50%; left: -20rpx;
  width: 340rpx; height: 8rpx; /* Horizontal line */
  background: linear-gradient(to right, #000 0%, #000 15%, transparent 15%, transparent 85%, #000 85%, #000 100%);
  transform: translateY(-50%);
}

@keyframes selectorSpin {
  0% { transform: translate(-50%, -50%) rotate(0deg); }
  100% { transform: translate(-50%, -50%) rotate(360deg); }
}


/* 底部开始区域 */
.start-zone {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  flex-direction: column; /* Ensure vertical stacking for centering */
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-top: 4px solid #000;
  padding: 40rpx;
  opacity: 0;
  transform: translateY(100%);
}

.start-zone.show {
  opacity: 1;
  transform: translateY(0);
}

.start-zone-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.start-zone-bg, .start-zone-glow { display: none; }

.start-zone-icon {
  font-size: 80rpx; /* Increased size */
  color: #000;
  margin-bottom: 20rpx;
  text-align: center;
}

.start-zone-text {
  font-size: 36rpx;
  font-weight: 900;
  color: #000;
  background: var(--accent-mint);
  padding: 16rpx 48rpx;
  border: 3px solid #000;
  border-radius: 20rpx;
  box-shadow: 4px 4px 0 0 #000;
}

/* 结果弹窗 */
.result-overlay {
  background: rgba(0, 0, 0, 0.6);
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.4s ease, visibility 0.4s ease;
}

.result-overlay.visible {
  opacity: 1; visibility: visible;
}

.result-container {
  background: #FFFDE7;
  border: 6px solid #000;
  padding: 60rpx;
  border-radius: 40rpx;
  box-shadow: 12px 12px 0 0 #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: scale(0.3);
  opacity: 0;
  transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease;
  min-width: 60%;
}

.result-overlay.visible .result-container {
  transform: scale(1); opacity: 1;
}

/* 获胜圆环 */
.winner-indicator {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}
.winner-ring {
  width: 100%;
  height: 100%;
  background: var(--winner-color);
  border: 6px solid #000;
  box-shadow: 6px 6px 0 0 #000;
  border-radius: 50%;
}
.winner-glow { display: none; }

.result-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-emoji {
  font-size: 100rpx; /* Bigger Emoji */
  display: block;
  margin-bottom: 16rpx;
  animation: emojiBounce 1s infinite alternate;
}

@keyframes emojiBounce {
  0% { transform: translateY(0); }
  100% { transform: translateY(-10rpx); }
}

.result-title {
  font-size: 60rpx;
  font-weight: 900;
  color: #000;
  background: none;
  -webkit-text-fill-color: #000;
  margin-bottom: 0;
  text-align: center;
}

.result-hint {
  color: #000;
  opacity: 0.6;
  font-weight: 700;
  font-size: 28rpx;
}

/* 粒子 */
.particle {
  background: #000;
  position: absolute;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
}

.result-overlay.visible .particle {
  animation: particleFly 2.5s ease-out infinite;
}

.particle.p1 { top: 28%; left: 18%; animation-delay: 0s; }
.particle.p2 { top: 22%; right: 22%; animation-delay: 0.4s; }
.particle.p3 { bottom: 32%; left: 12%; animation-delay: 0.8s; }
.particle.p4 { bottom: 28%; right: 18%; animation-delay: 1.2s; }
.particle.p5 { top: 42%; left: 8%; animation-delay: 1.6s; }
.particle.p6 { top: 38%; right: 8%; animation-delay: 2s; }

@keyframes particleFly {
  0% { opacity: 0; transform: scale(0) translateY(0); }
  15% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0.3) translateY(-250rpx); }
}
