/** 夜店弹幕 - 输入页面 - Neo-Brutalism (Pink) **/

.danmu-page {
  position: relative;
  min-height: 100vh;
  background-color: #FFFDE7; /* Cream */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  --accent-pink: #FF0055;
  --text-black: #000000;
}

/* 移除光效 */
.bg-glow, .grid-bg, .vignette { display: none; }

/* 返回按钮 */
.back-btn {
  position: fixed;
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border: 4px solid #000000;
  border-radius: 999rpx;
  z-index: 50;
  box-shadow: 4px 4px 0 0 #000000;
}

.back-btn:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 0 #000;
}

.back-icon {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  line-height: 1;
}

.back-text {
  font-size: 26rpx;
  color: #000000;
  font-weight: 800;
}

/* 输入界面 */
.setup-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  z-index: 10;
  width: 100%;
  max-width: 700rpx;
}

/* 大标题 */
.title-area {
  text-align: center;
  margin-bottom: 60rpx;
}

.setup-title {
  font-size: 72rpx;
  font-weight: 900;
  color: #000;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
  text-shadow: none;
  background: none;
  -webkit-text-fill-color: #000;
  text-transform: uppercase;
}

.setup-desc {
  font-size: 28rpx;
  color: #000;
  font-weight: 700;
  opacity: 0.6;
}

/* 输入卡片 - White Box */
.input-card {
  width: 100%;
  background: #FFFFFF;
  border: 4px solid #000;
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 8px 8px 0 0 #000;
  transition: all 0.2s ease;
}

.input-card:focus-within {
  transform: translate(-2px, -2px);
  box-shadow: 12px 12px 0 0 #000;
}

.danmu-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 36rpx;
  color: #000;
  line-height: 1.5;
  caret-color: var(--accent-pink);
  font-weight: 700;
}

.input-placeholder {
  color: #999;
}

.input-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.char-count {
  font-size: 24rpx;
  color: #000;
  font-weight: 700;
  font-family: 'DIN Alternate', sans-serif;
  padding: 4rpx 12rpx;
  background: #eee;
  border-radius: 8rpx;
}

/* 颜色选择器 */
.color-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 80rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  border: 4px solid #000;
  box-shadow: 6px 6px 0 0 #000;
}

.color-item {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 4px solid #fff; /* Separation ring */
  box-shadow: 0 0 0 2px #000; /* Outer black ring */
  transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.color-item.active {
  transform: scale(1.2);
  border-color: #000;
}

/* 播放按钮 (Pink Pill) */
.start-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%; 
  height: 120rpx;
  background: var(--accent-pink);
  border: 4px solid #000;
  border-radius: 60rpx;
  box-shadow: 8px 8px 0 0 #000;
  transition: all 0.2s ease;
  margin-bottom: 30rpx;
}

.start-btn:active {
  transform: translate(4px, 4px);
  box-shadow: 4px 4px 0 0 #000;
}

.start-btn-text {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 8rpx;
  text-shadow: 2px 2px 0 #000;
}

.hint-text {
  font-size: 24rpx;
  color: #000;
  font-weight: 600;
  opacity: 0.5;
}
