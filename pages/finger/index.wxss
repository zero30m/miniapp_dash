/* Global Container - Neo-Brutalism Style */
page {
  --bg-cream: #FFFDE7;
  --text-black: #000000;
  --border-black: #000000;
  --accent-green: #4CAF50;
  --accent-yellow: #F0E634; /* Kano Yellow */
  --accent-orange: #FF5F1F;
  
  --shadow-hard: 6px 6px 0px 0px #000000;
  --shadow-hard-sm: 4px 4px 0px 0px #000000;
  
  --radius-std: 24rpx;
}

.container {
  width: 100vw;
  height: 100vh;
  background-color: var(--bg-cream);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.container.fade-in {
  opacity: 1;
}

/* Layout */
.game-layout {
  display: flex;
  flex-direction: row;
  width: 96%;
  height: 90%;
  z-index: 1;
  gap: 30rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* Card Section */
.card-section {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.neo-card {
  height: 100%;
  width: 100%;
  max-width: 1200rpx;
  background: #FFFFFF;
  border: 4px solid var(--border-black);
  border-radius: var(--radius-std);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: var(--shadow-hard);
  transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow: hidden;
}

.card-content {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: stretch;
  justify-content: flex-start;
}

/* Text Question Mode */
.question-container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center; /* Centered vertically */
  width: 100%;
  height: 100%;
  padding: 40rpx; /* Reduced for more space */
  box-sizing: border-box;
}

.question-title {
  position: absolute;
  top: 30rpx; /* Reduced */
  left: 40rpx;
  font-size: 28rpx; /* Reduced */
  color: var(--text-black);
  font-weight: 900;
  text-transform: uppercase;
  background: var(--accent-yellow);
  padding: 8rpx 20rpx;
  border: 2px solid var(--border-black);
  box-shadow: 2px 2px 0 0 #000;
  border-radius: 8rpx;
  z-index: 10;
}

.question-content {
  font-size: 38rpx; /* Reduced from 48rpx */
  color: var(--text-black);
  font-weight: 900;
  text-align: left;
  line-height: 1.4;
  width: 100%;
  max-width: 100%;
  overflow-y: auto;
  padding-top: 50rpx; /* Reduced */
}

/* Adaptive Font Sizes */
.text-medium {
  font-size: 32rpx; /* Reduced from 40rpx */
}

.text-small {
  font-size: 28rpx; /* Reduced from 32rpx */
  line-height: 1.5;
}

/* Image Mode */
.card-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
  transition: opacity 0.3s ease;
}

.card-image.hidden {
  opacity: 0;
}

/* Loading State */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #000;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: var(--text-black);
  font-size: 28rpx;
  font-weight: 900;
  text-transform: uppercase;
}

/* Error State */
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error-text {
  color: var(--text-black);
  font-size: 32rpx;
  font-weight: 900;
}

/* Animations */
.card-exit {
  transform: translate(-10px, 10px); /* Minimal movement */
  opacity: 0;
}

.card-enter {
  animation: cardEnter 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes cardEnter {
  from {
    transform: translate(10px, 10px);
    opacity: 0;
  }
  to {
    transform: translate(0, 0);
    opacity: 1;
  }
}

/* Control Section (Right Side) */
.control-section {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
}

/* Back Button */
.back-btn {
  width: 100rpx;
  height: 100rpx;
  background: #FFFFFF;
  border: 4px solid #000000;
  border-radius: 50%; /* Circle */
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: auto; /* Push to top */
  box-shadow: var(--shadow-hard-sm);
  transition: all 0.1s;
}

.back-btn-text {
  color: #000;
  font-size: 20rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.back-btn:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 0 #000;
}

/* Neo Buttons (NEXT / LAST) */
.neo-btn {
  width: 120rpx;
  height: 120rpx;
  background: var(--accent-green); /* Default for NEXT */
  border: 4px solid #000000;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-hard-sm);
  transition: all 0.1s ease;
}

.neo-btn.last-btn {
  background: #FFFFFF; /* White for LAST */
  height: 80rpx; /* Smaller */
  width: 120rpx;
}

.next-btn {
  /* Main action */
  background: var(--accent-orange); 
  height: 160rpx; /* Larger */
}

.neo-btn:active, .btn-hover {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 0 #000;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #000;
  text-transform: uppercase;
}
