/* 时空裂缝访客页样式 */

page {
    background: #FFFDE7;
    height: 100vh;
    overflow: hidden;
}

.container {
    height: 100vh;
    overflow: hidden;
    background: #FFFDE7;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 60rpx 40rpx env(safe-area-inset-bottom);
    box-sizing: border-box;
    touch-action: none;
}

/* 发起人信息卡片 */
.initiator-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.initiator-avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid #000000;
    margin-bottom: 12rpx;
}

.initiator-name {
    font-size: 32rpx;
    font-weight: 800;
    color: #000000;
}

/* 发送后的大字文案 */
.sent-message {
    margin-top: 24rpx;
    margin-bottom: 16rpx;
    flex-shrink: 0;
    text-align: center;
}

.sent-message-text {
    display: block;
    font-size: 36rpx;
    font-weight: 900;
    color: #000000;
    line-height: 1.6;
}

/* 主要内容区域 */
.main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
}

/* 主要文案 */
.message-section {
    text-align: center;
    margin-bottom: 32rpx;
}

.message-text {
    display: block;
    font-size: 32rpx;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.7);
    line-height: 1.6;
}

.message-highlight {
    display: block;
    font-size: 40rpx;
    font-weight: 900;
    color: #000000;
    margin-top: 16rpx;
}

/* 副文案 */
.sub-message {
    text-align: center;
    margin-bottom: 60rpx;
}

.sub-text {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.6);
    line-height: 1.8;
}

/* Hi 按钮 */
.hi-button-wrapper {
    margin-bottom: 48rpx;
}

.hi-button {
    width: 200rpx;
    height: 200rpx;
    border-radius: 50%;
    background: #9B5DE5;
    border: 6rpx solid #000000;
    box-shadow: 8rpx 8rpx 0 0 #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    padding: 0;
}

.hi-button::after {
    border: none;
}

.hi-button:active {
    transform: translate(4rpx, 4rpx);
    box-shadow: 4rpx 4rpx 0 0 #000000;
}

.hi-text {
    font-size: 72rpx;
    font-weight: 900;
    color: #FFFFFF;
    letter-spacing: -4rpx;
}

/* 隐私提示 */
.privacy-hint {
    margin-top: 20rpx;
    text-align: center;
}

.privacy-text {
    display: block;
    font-size: 24rpx;
    font-weight: 600;
    color: rgba(0, 0, 0, 0.5);
}

.privacy-text-sub {
    display: block;
    font-size: 22rpx;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.35);
    margin-top: 8rpx;
}

/* ==================== 完成状态 ==================== */
.complete-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-top: 60rpx;
}

.complete-icon-wrapper {
    margin-bottom: 32rpx;
}

.complete-icon {
    width: 120rpx;
    height: 120rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #000000;
    color: #FFFFFF;
    font-size: 64rpx;
    font-weight: 900;
    border: 4rpx solid #000000;
    box-shadow: 6rpx 6rpx 0 0 rgba(0, 0, 0, 0.3);
}

.complete-title {
    font-size: 44rpx;
    font-weight: 900;
    color: #000000;
    margin-bottom: 48rpx;
}

/* 转化引导 */
.convert-section {
    text-align: center;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.convert-questions {
    margin-bottom: 40rpx;
}

.convert-text {
    display: block;
    font-size: 26rpx;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.5);
    line-height: 1.8;
}

.convert-text-highlight {
    display: block;
    font-size: 28rpx;
    font-weight: 700;
    color: #000000;
    line-height: 1.8;
    margin-top: 16rpx;
}

.convert-btn {
    width: 400rpx;
    height: 96rpx;
    background: #9B5DE5 !important;
    border-radius: 999rpx;
    border: 4rpx solid #000000;
    box-shadow: 6rpx 6rpx 0 0 #000000;
    transition: all 0.1s ease;
    margin-bottom: 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.convert-btn .btn-text {
    font-size: 32rpx;
    font-weight: 900;
    color: #FFFFFF;
}

.convert-btn::after {
    border: none;
}

.convert-btn:active {
    transform: translate(3rpx, 3rpx);
    box-shadow: 3rpx 3rpx 0 0 #000000;
}

/* ==================== 单页模式样式 ==================== */

/* 单页模式引导 */
.single-page-guide {
    margin-top: 48rpx;
    padding: 32rpx 40rpx;
    text-align: center;
    background: rgba(155, 93, 229, 0.1);
    border-radius: 20rpx;
    border: 2rpx dashed rgba(155, 93, 229, 0.4);
}

.guide-text {
    font-size: 28rpx;
    font-weight: 700;
    color: #9B5DE5;
    line-height: 1.6;
}

/* 单页模式下的 Hi 按钮（半透明提示状态） */
.hi-button-disabled {
    opacity: 0.6;
}

/* 单页模式提示（已互动后，已不再使用但保留兼容） */
.single-page-hint {
    margin-top: 48rpx;
    padding: 32rpx;
    text-align: center;
}

.hint-text {
    font-size: 28rpx;
    font-weight: 700;
    color: rgba(0, 0, 0, 0.6);
}
