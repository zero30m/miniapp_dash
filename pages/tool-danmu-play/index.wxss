/** 夜店弹幕 - 横屏播放页面 **/

.play-page {
  width: 100vw;
  height: 100vh;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
  position: relative;
}

/* 弹幕外层容器 */
.danmu-wrapper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* 弹幕轨道 - 使用单份内容 + CSS技巧实现无缝 */
.danmu-track {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  will-change: transform;
  animation: marqueeScroll var(--duration, 8s) linear infinite;
  /* 使用3D变换启用硬件加速，避免闪烁 */
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 无缝滚动动画 */
@keyframes marqueeScroll {
  0% {
    transform: translate3d(0, 0, 0);
  }
  100% {
    transform: translate3d(-50%, 0, 0);
  }
}

/* 单个弹幕项 */
.danmu-item {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  /* 固定间距确保两份内容之间有空隙 */
  margin-right: 50vw;
}

/* 白色大号弹幕文字 */
.danmu-text {
  font-size: 200rpx; /* 略微加大 */
  font-weight: 900;
  /* color & text-shadow 由 inline style 控制 */
  letter-spacing: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
  /* 避免闪烁 */
  -webkit-font-smoothing: antialiased;
  flex-shrink: 0;
  /* 避免闪烁 */
  -webkit-font-smoothing: antialiased;
}

/* 点击退出提示 */
.tap-hint {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.15);
  z-index: 10;
}
