  flex-direction: column;
  gap: 16rpx;
  align-items: flex-start; /* Left align text */
}

/* Show Detail Info */
.game-card.expanded .detail-info {
  display: flex;
}

.detail-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.detail-name {
  font-size: 36rpx; /* Restored size */
  font-weight: 900;
  color: var(--text-black);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* Highlight Name in Expanded View based on Theme */
.game-card.expanded.active.drinking .detail-name { color: var(--accent-red); }
.game-card.expanded.active.kiss .detail-name { color: var(--accent-pink); }
.game-card.expanded.active.chess .detail-name { color: var(--accent-yellow); text-shadow: 1px 1px 0 #000; }
.game-card.expanded.active.dare .detail-name { color: var(--accent-cyan); }
.game-card.expanded.active.coffee .detail-name { color: var(--accent-coffee); }
.game-card.expanded.active.we .detail-name { color: var(--accent-forest); }
.game-card.expanded.active.zhexuejia .detail-name { color: var(--accent-purple); }
.game-card.expanded.active.taiqiu .detail-name { color: var(--accent-teal); }
.game-card.expanded.active.couple_dare .detail-name { color: var(--accent-heartbeat); }
.game-card.expanded.active.couple_talk .detail-name { color: var(--accent-sweettalk); }
.game-card.expanded.active.more .detail-name { color: var(--accent-blue); }

.detail-desc {
  font-size: 20rpx;
  font-weight: 700;
  color: #000;
  background: #FFF;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid #000;
  box-shadow: 2px 2px 0 0 #000;
}

.detail-intro {
  font-size: 24rpx; /* Restored size */
  color: #333;
  line-height: 1.5;
  font-weight: 500;
  /* Multi-line clamp */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  text-align: left;
}

.detail-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-top: auto; /* Push to bottom */
}

.detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.detail-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--text-black);
  background: #fff;
  border: 2rpx solid #000;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 2px 2px 0 0 #000;
}

/* Play Count Tag */
.play-count-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  background: #000;
  border-radius: 20rpx;
  border: 2rpx solid #000;
}

.tag-icon {
  font-size: 20rpx;
  color: #FFF;
}

.tag-num {
  font-size: 22rpx;
  color: #FFF;
  font-weight: 700;
  font-family: 'SF Mono', monospace;
}

/* Scroll Hint */
.scroll-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 30rpx;
  opacity: 0.8;
}

.scroll-text {
  font-size: 24rpx;
  color: var(--text-black);
  font-weight: 700;
  background: #FFF;
  padding: 6rpx 16rpx;
  border: 2rpx solid #000;
  border-radius: 20rpx;
}

.scroll-arrow {
  color: var(--text-black);
  font-weight: 900;
  font-size: 32rpx;
}

/* Close Hint */
.close-hint {
  margin-top: 20rpx;
  opacity: 0.6;
}

.close-hint-text {
  font-size: 22rpx;
  color: #555;
  font-weight: 600;
  text-transform: uppercase;
}

/* ==========================================
   游戏容器
   ========================================== */
.game-container {
  flex: 1;
  min-height: 0;
  width: 100%;
  position: relative;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transition: opacity 0.4s, transform 0.4s;
}

.game-stage-host {
  display: block;
  flex: 1;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.container.expanded-mode .game-container {
  filter: blur(10px);
  opacity: 0.3;
  transform: scale(0.95);
}

/* Placeholder Game */
.placeholder-game {
  width: 90%;
  height: 80%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 4rpx solid var(--border-black);
  box-shadow: var(--shadow-hard);
  border-radius: var(--radius-std);
}

.placeholder-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.placeholder-icon {
  font-size: 100rpx;
}

.placeholder-title {
  font-size: 48rpx;
  color: var(--text-black);
  font-weight: 900;
}

.placeholder-desc {
  font-size: 28rpx;
  color: #666;
  font-weight: 700;
}

/* Entry Animation */
.page-entry-animate .pill-header {
  animation: slideDownFade 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@keyframes slideDownFade {
  from { opacity: 0; transform: translateY(-40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==========================================
   「新」斜向胶带标记
   ========================================== */
.new-tape {
  position: absolute;
  top: 16rpx;
  right: -36rpx;
  width: 120rpx;
  padding: 4rpx 0;
  background: #FF5252;
  color: #FFF;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
  line-height: 1.4;
  transform: rotate(45deg);
  transform-origin: center center;
  z-index: 10;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.18);
  pointer-events: none;
}

/* 详情视图下卡片更宽，胶带位置微调 */
.game-card.expanded .new-tape {
  top: 14rpx;
  right: -30rpx;
  width: 110rpx;
  font-size: 18rpx;
}
