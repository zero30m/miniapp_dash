page {
  background: #FFFDE7;
  color: #000;
}

.detail-page {
  min-height: 100vh;
  background: #FFFDE7;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 60rpx);
  box-sizing: border-box;
}

.hero-card {
  background: #FFFDF2;
  border: 4rpx solid #000;
  border-radius: 18rpx;
  box-shadow: 5rpx 5rpx 0 #000;
  padding: 30rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 34rpx;
  position: relative;
}

.hero-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 12rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #E7402E;
}

.red-envelope-stage {
  position: relative;
  width: 154rpx;
  height: 154rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  flex-shrink: 0;
}

.red-envelope-image {
  width: 138rpx;
  height: 138rpx;
  position: relative;
  z-index: 1;
}

.amount-content {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.amount-label {
  position: relative;
  z-index: 1;
  display: inline-flex;
  font-size: 23rpx;
  font-weight: 900;
  color: #fff;
  background: #E7402E;
  border: 3rpx solid #000;
  border-radius: 999rpx;
  padding: 7rpx 20rpx;
}

.amount-status-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  min-width: 0;
}

.amount-row {
  display: flex;
  align-items: baseline;
  color: #000;
  min-width: 0;
  flex: 1;
}

.amount-symbol {
  font-size: 38rpx;
  font-weight: 900;
  margin-right: 8rpx;
}

.amount {
  font-size: 66rpx;
  font-weight: 900;
  line-height: 1;
  word-break: break-all;
}

.status-pill {
  position: relative;
  z-index: 1;
  display: inline-flex;
  flex-shrink: 0;
  background: #FFE84A;
  color: #000;
  border: 3rpx solid #000;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.info-item,
.time-card,
.joined-card,
.result-card,
.error-card {
  background: #fff;
  border: 5rpx solid #000;
  border-radius: 18rpx;
  box-shadow: 6rpx 6rpx 0 #000;
}

.info-item {
  padding: 28rpx 16rpx;
  text-align: center;
}

.info-value {
  display: block;
  font-size: 46rpx;
  font-weight: 900;
}

.info-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.55);
}

.time-card {
  padding: 28rpx;
  margin-bottom: 44rpx;
}

.time-label {
  display: block;
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.55);
}

.time-value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.join-section {
  display: flex;
  justify-content: center;
  margin-top: 96rpx;
  margin-bottom: 24rpx;
}

.join-button-wrap {
  position: relative;
  width: 430rpx;
  height: 430rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.join-ripple {
  position: absolute;
  width: 310rpx;
  height: 310rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 132, 0, 0.72);
  background: rgba(255, 166, 0, 0.38);
  animation: joinRipple 2.35s ease-in-out infinite;
}

.join-ripple.ring-two {
  border-color: rgba(255, 90, 0, 0.48);
  background: rgba(255, 111, 0, 0.24);
  animation-delay: 1.18s;
}

button.join-button {
  width: 310rpx;
  height: 310rpx;
  min-width: 310rpx;
  min-height: 310rpx;
  max-width: 310rpx;
  max-height: 310rpx;
  border-radius: 50%;
  border: 6rpx solid #000;
  background: #FFE84A !important;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  position: relative;
  z-index: 1;
  line-height: 1.15;
  overflow: hidden;
  box-sizing: border-box;
  font-size: 44rpx;
  font-weight: 900;
  color: #000 !important;
  text-align: center;
  white-space: normal;
}

button.join-button::after {
  border: none;
}

button.join-button[disabled] {
  opacity: 0.82;
  background: #FFE84A !important;
  color: #000 !important;
}

button.join-button:active {
  transform: scale(0.96);
}

@keyframes joinRipple {
  0% {
    transform: scale(0.78);
    opacity: 0.85;
  }
  50% {
    transform: scale(1.38);
    opacity: 0.12;
  }
  100% {
    transform: scale(0.78);
    opacity: 0.85;
  }
}

.joined-card {
  width: 100%;
  padding: 42rpx 30rpx;
  text-align: center;
  background: #FFE84A;
}

.joined-title {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
}

.joined-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.lucky-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #000;
  line-height: 1.3;
  white-space: nowrap;
}

.lucky-label {
  color: rgba(0,0,0,0.68);
}

.lucky-code {
  display: inline-flex;
  align-items: center;
  font-family: Arial, Helvetica, sans-serif;
  color: #E7402E;
  margin-left: 4rpx;
  letter-spacing: 0;
  line-height: 1;
  white-space: nowrap;
}

.result-lucky-line {
  margin-top: 16rpx;
  margin-bottom: 4rpx;
}

.result-card,
.error-card,
.admin-winners-card {
  padding: 44rpx 30rpx;
  text-align: center;
}

.admin-winners-card {
  margin-top: 28rpx;
  background: #fff;
  border: 5rpx solid #000;
  border-radius: 18rpx;
  box-shadow: 6rpx 6rpx 0 #000;
  text-align: left;
}

.admin-winners-title {
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 22rpx;
}

.admin-winner-row {
  display: grid;
  grid-template-columns: 86rpx 1fr auto;
  gap: 14rpx;
  align-items: center;
  border: 3rpx solid #000;
  border-radius: 12rpx;
  background: #FFFDE7;
  padding: 16rpx 18rpx;
  margin-top: 14rpx;
}

.winner-rank {
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.58);
}

.winner-lucky-code {
  font-size: 30rpx;
  font-weight: 900;
  color: #E7402E;
  letter-spacing: 1rpx;
}

.winner-prize {
  font-size: 24rpx;
  font-weight: 900;
  color: #000;
}

.result-badge {
  display: inline-flex;
  border: 4rpx solid #000;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 #000;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 900;
  margin-bottom: 28rpx;
}

.result-badge.winner {
  background: #FFE84A;
}

.result-badge.missed {
  background: #A0E7E5;
}

.result-badge.drawing {
  background: #B9FBC0;
}

.result-title,
.error-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.result-desc,
.error-sub,
.copy-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.58);
  line-height: 1.5;
}

.wechat-copy {
  margin: 28rpx auto 0;
  display: inline-flex;
  background: #000;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.refresh-button {
  margin: 30rpx auto 0;
  display: inline-flex;
  background: #000;
  color: #fff;
  border-radius: 999rpx;
  padding: 18rpx 42rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.loading {
  padding: 180rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 900;
}
