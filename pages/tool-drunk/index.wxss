page {
  --accent-purple: #9B5DE5;
  --text-black: #000000;
}

/* 喝醉了吗页面 - Neo-Brutalism (Purple) */
.drunk-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background-color: #FFFDE7; /* Cream */
  overflow: hidden;
  touch-action: none;
  color: #000;
}

.drunk-page.blurred {
  filter: blur(10px);
}

/* 移除光效 */
.bg-glow { display: none; }

/* 返回按钮 */
.back-btn {
  position: fixed;
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border: 4px solid #000000;
  border-radius: 999rpx;
  z-index: 50;
  box-shadow: 4px 4px 0 0 #000000;
}

.back-btn:active {
  transform: translate(2px, 2px);
  box-shadow: 2px 2px 0 0 #000;
}

.back-icon {
  font-size: 36rpx;
  font-weight: 900;
  color: #000000;
  line-height: 1;
}

.back-text {
  font-size: 26rpx;
  color: #000000;
  font-weight: 800;
}

/* Share Arrow/Text */
.share-arrow { color: #000; font-weight: 900; }
.share-text { color: #000; font-weight: 700; }

/* 房间信息栏 */
.room-info-bar {
  position: fixed;
  background: #FFFFFF;
  border: 3px solid #000;
  border-radius: 12rpx;
  box-shadow: 4px 4px 0 0 #000;
  padding: 8rpx 20rpx;
  opacity: 0;
  transform: translateY(-10rpx);
  pointer-events: none;
  z-index: 50;
}

.room-info-bar.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.connection-dot {
  background: #ccc;
  border: 1px solid #000;
}
.room-id-text, .member-count {
  color: #000;
  font-weight: 800;
  font-size: 24rpx;
}

/* ==================== 初始界面 ==================== */
/* Share Hint - Old Man Style (Speech Bubble) */
.share-arrow {
  display: none; /* Hide old arrow */
}

.share-hint {
  position: fixed;
  z-index: 60;
  background: #FFF;
  border: 4px solid #000;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 6px 6px 0 rgba(0,0,0,0.2);
  /* Pivot for bounce */
  transform-origin: right top;
  animation: hintBounce 1.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
}

/* Speech Bubble Tail (Rotated Square) */
.share-hint::before {
  content: '';
  position: absolute;
  top: -16rpx; /* Push up slightly */
  right: var(--arrow-right, 20rpx); /* Default if var missing, but JS sets menuRight? Wait, JS sets menuRight not arrow-right. I need to check JS. */
  /* Re-reading JS: menuDotRight is calculated. CSS uses menuRight in WXML style inline. 
     The OLD MAN CSS used var(--arrow-right). 
     The DRUNK PAGE WXML uses style="top:..; right: {{menuRight}}px;" on the CONTAINER.
     So the ::before just needs to be positioned relative to that container.
     Actually, if the container is positioned at menuRight, the arrow needs to point to the DOT.
     The dot is to the right of menuRight.
     Let's adjust.
     In WXML: right: {{menuRight}}px
     The dot is at menuDotRight.
     Offset = menuDotRight - menuRight = (menuRight + width*0.75) - menuRight = width*0.75.
     So the arrow tail should be at right: -10rpx (approx) or calculated.
     Let's style it generic first, similar to Old Man but adapted.
  */
  right: 20rpx; /* Position inside bubble? No, pseudo is absolute to bubble. */
  width: 24rpx;
  height: 24rpx;
  background: #FFF;
  border-top: 4px solid #000;
  border-left: 4px solid #000;
  transform: rotate(45deg) translateX(50%);
  box-sizing: border-box;
  z-index: 1;
}

.share-hint::after {
  content: '';
  position: absolute;
  top: 0;
  right: 10rpx;
  width: 40rpx;
  height: 12rpx;
  background: #FFF;
  z-index: 2;
}

@keyframes hintBounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(6rpx) rotate(-1deg); }
}

.share-text {
  color: #000;
  font-weight: 800;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}
.setup-container {
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.setup-container.show { opacity: 1; pointer-events: auto; }

/* 徽章 */
.setup-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 30rpx;
  background: #000;
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: var(--accent-purple);
  text-shadow: none;
}

.setup-title {
  font-size: 72rpx;
  font-weight: 900;
  color: #000;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
  text-shadow: none;
  text-transform: uppercase;
}

.setup-divider {
  width: 120rpx;
  height: 6rpx;
  background: #000;
  box-shadow: none;
}

.setup-desc {
  font-size: 32rpx;
  color: #000;
  font-weight: 800;
  opacity: 0.8;
}

.setup-subdesc {
  font-size: 26rpx;
  color: #000;
  opacity: 0.5;
  margin-bottom: 60rpx;
}

/* 开始按钮 */
.start-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 440rpx;
  height: 120rpx;
  background: var(--accent-purple);
  border: 4px solid #000;
  border-radius: 999rpx;
  box-shadow: 6px 6px 0 0 #000;
  transition: all 0.2s ease;
}

.start-btn:active {
  transform: translate(4px, 4px);
  box-shadow: 2px 2px 0 0 #000;
}

.start-btn-text {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff; /* White text on Purple button */
  letter-spacing: 4rpx;
  text-shadow: 2px 2px 0 #000;
}

/* 联机测试进度 */
.online-progress {
  margin-top: 40rpx;
  padding: 16rpx 32rpx;
  background: #fff;
  border: 3px solid #000;
  border-radius: 20rpx;
  box-shadow: 4px 4px 0 0 #000;
}

.progress-text {
  font-size: 24rpx;
  color: #000;
  font-weight: 700;
}

/* ==================== 等待界面 (Missing Styles Fixed) ==================== */
.waiting-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  opacity: 0;
  visibility: hidden; /* Fix ghost text */
  transition: opacity 0.5s ease, visibility 0.5s ease;
  pointer-events: none;
  z-index: 15;
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.waiting-container.show {
  opacity: 1; visibility: visible;
}

.waiting-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  animation: pulse 2s infinite;
}

.waiting-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #000;
  margin-bottom: 20rpx;
}

.waiting-progress {
  font-size: 60rpx;
  font-weight: 900;
  color: var(--accent-purple);
  margin-bottom: 20rpx;
  text-shadow: 2px 2px 0 #000;
  -webkit-text-stroke: 1px #000;
}

.waiting-desc {
  font-size: 28rpx;
  color: #000;
  opacity: 0.7;
  margin-bottom: 40rpx;
}

.my-result-preview {
  background: #fff;
  border: 3px solid #000;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 4px 4px 0 0 #000;
}

.preview-emoji { font-size: 40rpx; }
.preview-title { font-size: 28rpx; font-weight: 800; color: #000; }

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}


/* ==================== 测试进行中 ==================== */
.testing-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
  z-index: 15;
  width: 80%;
}

.testing-container.show { opacity: 1; }

.testing-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #000;
  margin-bottom: 20rpx;
}

.testing-countdown {
  font-size: 200rpx;
  font-weight: 900;
  color: #000; /* Black countdown */
  text-shadow: none;
  animation: countPulse 1s ease-in-out infinite;
  font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, sans-serif;
  margin-bottom: 60rpx;
}

/* 抖动程度计 - Retro Progress Bar */
.shake-meter {
  position: relative;
  width: 100%;
  height: 48rpx;
  background: #EEE;
  border: 4px solid #000;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 4px 4px 0 0 #000;
  /* 【Fix】裁剪到内边缘，让填充条的圆角能完美贴合 */
  clip-path: inset(0 round 24rpx);
  transform: translateZ(0);
}

.shake-meter-bg { display: none; }

.shake-meter-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  /* Gradient: Green -> Yellow -> Red */
  background: linear-gradient(90deg, #4CAF50 0%, #FFEB3B 50%, #FF5F1F 100%);
  border-right: 4px solid #000;
  /* 【Fix】恢复 transition 以提供平滑动画，使用 ease-out 缓动 */
  transition: width 0.1s ease-out;
  box-shadow: none;
  /* 【Fix】左侧圆角匹配容器内边缘的曲线 */
  border-radius: 24rpx 0 0 24rpx;
  /* 【Fix】最小宽度确保圆角始终可见 */
  min-width: 8rpx;
  /* 【Fix】GPU 加速防止重绘闪烁 */
  will-change: width;
  transform: translateZ(0);
}

/* 阈值线 */
.shake-threshold {
  position: absolute;
  top: -10rpx;
  width: 4px;
  height: 68rpx;
  background: #000;
  box-shadow: none;
  transform: translateX(-50%);
  z-index: 2;
}

.shake-threshold::after {
  content: '醉酒线';
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 22rpx;
  color: #000;
  font-weight: 900;
  white-space: nowrap;
  background: #FFF;
  padding: 2rpx 8rpx;
  border: 2px solid #000;
  border-radius: 8rpx;
}

/* 当前抖动指示器 */
.shake-indicator {
  position: absolute;
  top: 50%;
  width: 32rpx;
  height: 32rpx;
  background: #FFF;
  border: 4px solid #000;
  border-radius: 50%;
  transform: translate(-50%, -50%) translateZ(0);
  box-shadow: none;
  /* 【Fix】恢复 transition 以提供平滑动画 */
  transition: left 0.1s ease-out;
  z-index: 3;
  /* 【Fix】GPU 加速 */
  will-change: left;
}

.shake-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 60rpx;
}

.shake-label {
  font-size: 24rpx;
  color: #000;
  font-weight: 800;
}

.shake-wave-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
}

.shake-wave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%);
  border: 6rpx solid var(--accent-purple);
  border-radius: 50%;
  animation: waveRipple 1s ease-out infinite;
}

@keyframes waveRipple {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.8); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.5); }
}


/* ==================== 结果界面 (Paper Modal) ==================== */
.result-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: none;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.result-overlay.visible {
  display: flex !important;
  opacity: 1;
}

.result-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 85%;
  background: #FFFDE7;
  border: 6px solid #000;
  padding: 60rpx;
  border-radius: 40rpx;
  box-shadow: 12px 12px 0 0 #000;
  margin: auto;
  transform: scale(0.9);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  color: #000;
}

.result-overlay.visible .result-container {
  transform: scale(1);
}

.result-emoji {
  font-size: 160rpx;
  animation: emojiFloat 1.5s ease-in-out infinite;
  margin-bottom: 30rpx;
}

/* Result Title on separate line */
.result-text-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  width: 100%;
}

.result-title {
  font-size: 64rpx;
  font-weight: 900;
  color: #000;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  background: none;
  -webkit-text-fill-color: #000;
  text-align: center;
  display: block; /* Ensure separate line */
}

.result-desc {
  font-size: 30rpx;
  color: #000;
  text-align: center;
  line-height: 1.5;
  font-weight: 600;
  opacity: 0.8;
  padding: 0 20rpx;
}

/* 结果抖动程度条 - Result Meter */
.result-meter {
  position: relative;
  width: 100%;
  height: 48rpx;
  background: #EEE;
  border: 4px solid #000;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 4px 4px 0 0 #000;
  /* 【Fix】裁剪到内边缘，让填充条的圆角能完美贴合 */
  clip-path: inset(0 round 24rpx);
  transform: translateZ(0);
}

.result-meter-fill {
  background: linear-gradient(90deg, #4CAF50 0%, #FFEB3B 50%, #FF5F1F 100%);
  border-right: 4px solid #000;
  height: 100%;
  width: 0%;
  /* 【Fix】左侧圆角匹配容器内边缘的曲线 */
  border-radius: 24rpx 0 0 24rpx;
  min-width: 8rpx;
}

/* Animation on result show */
.result-overlay.visible .result-meter-fill {
  animation: fillProgress 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  /* Note: Animation needs target width. 
     Since width is set inline in style, we can't keyframe it easily to dynamic width 
     WITHOUT 'width: var(--width)' trick or simple transition.
     Let's use Transition. 
  */
  transition: width 1.5s cubic-bezier(0.22, 1, 0.36, 1);
  width: var(--final-width); /* Logic change needed in JS? No, inline style handles it. 
     But opacity needs to start 0?
     Actually, transition works if width changes.
     In WXML: style="width: {{finalShakePercent}}%;"
     When Result State enters, finalShakePercent is set.
     We need to ensure it STARTS at 0 then animates.
     CSS Transition is best. Added transition above.
  */
}

.result-meter-labels {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 40rpx;
}

.result-meter-labels text {
  color: #000;
  font-weight: 700;
  font-size: 24rpx;
}

.result-hint {
  font-size: 28rpx;
  color: #000;
  font-weight: 700;
  opacity: 0.6;
}

/* 联机输家弹窗 */
.loser-modal {
  z-index: 101;
}

.loser-glow { display: none; }

.loser-icon-wrap {
  margin-bottom: 30rpx;
  position: relative;
  display: flex;
  justify-content: center;
}

.loser-emoji, .winner-emoji {
  font-size: 140rpx; /* 【Fix】Much bigger icon */
  display: block;
}

.result-text {
  text-align: center;
  margin-bottom: 20rpx;
}

.loser-finger {
  font-size: 80rpx;
  display: block;
  margin-bottom: 10rpx;
}

.loser-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #000;
}

.result-drink-hint {
  font-size: 32rpx;
  font-weight: 800;
  color: #000;
  text-align: center;
  background: var(--accent-purple);
  padding: 10rpx 30rpx;
  border: 3px solid #000;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  color: #fff;
}

.shake-value-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.shake-value-label {
  font-size: 24rpx;
  font-weight: 700;
  opacity: 0.7;
}

.shake-value-num {
  font-size: 60rpx;
  font-weight: 900;
  color: #000;
}

.particle {
  background: #000;
  position: absolute;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
}

.result-overlay.visible .particle {
  animation: particleFly 2.5s ease-out infinite;
}

@keyframes particleFly {
  0% { opacity: 0; transform: scale(0) translateY(0); }
  15% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0.3) translateY(-250rpx); }
}
